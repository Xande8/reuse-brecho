:root{--orange:#F34D19;--cream:#FFF9F4;--ink:#241C18;--line:#EFE2D8;--muted:#9C8C82;--success:#23864B;--danger:#B42318}*{box-sizing:border-box}body{margin:0;font-family:'Manrope',sans-serif;background:var(--cream);color:var(--ink)}h1,h2,h3,.serif{font-family:'Fraunces',serif}.wrap{max-width:1100px;margin:auto;padding:24px 20px 80px}header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line);background:var(--cream);position:sticky;top:0;z-index:10}header h1{font-size:1.2rem;margin:0}.logout,.ghost,.secondary{background:transparent;border:1px solid var(--line);border-radius:100px;padding:8px 14px;cursor:pointer}.primary{background:var(--orange);color:#fff;border:0;border-radius:100px;padding:11px 18px;font-weight:800;cursor:pointer}.danger{background:#fff;border:1px solid #e5b8b4;color:var(--danger);border-radius:100px;padding:8px 14px;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}input,select,textarea{width:100%;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:9px;padding:10px 12px;margin-bottom:10px;outline:0}input:focus,select:focus,textarea:focus{border-color:var(--orange)}label{display:block;font-size:.78rem;font-weight:800;margin-bottom:4px}.hint{font-size:.73rem;color:var(--muted);margin:-4px 0 12px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 18px}.tab{background:transparent;border:1px solid var(--line);border-radius:100px;padding:8px 15px;font-weight:700;cursor:pointer}.tab.active{background:var(--ink);color:var(--cream);border-color:var(--ink)}.panel{display:none}.panel.active{display:block}.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:12px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:0 12px}.form-actions{display:flex;gap:8px;flex-wrap:wrap}.msg{font-size:.78rem;min-height:18px;margin-top:8px;color:var(--danger)}.msg.ok{color:var(--success)}.product-row{display:flex;gap:14px;align-items:flex-start}.product-row img{width:72px;height:90px;object-fit:cover;border-radius:9px;background:var(--line);flex:0 0 auto}.product-info{flex:1;min-width:180px}.product-info h3{margin:0 0 4px;font-size:1rem}.meta{font-size:.76rem;color:var(--muted);line-height:1.55}.badge{display:inline-block;margin-top:6px;padding:3px 9px;border-radius:99px;background:var(--line);font-size:.68rem;font-weight:800}.badge.vendido{background:#eee;color:#777}.badge.reservado{background:#fff0e9;color:var(--orange)}.badge.disponivel{background:#e9f6ee;color:var(--success)}.actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.actions select{width:auto;margin:0;padding:7px 10px;font-size:.75rem}.thumbs{display:flex;gap:8px;flex-wrap:wrap;margin:5px 0 12px}.thumb{position:relative}.thumb img{width:68px;height:84px;object-fit:cover;border-radius:7px}.order-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.order-number{font-weight:800}.order-total{font-family:'Fraunces';font-size:1.25rem}.order-items{margin:10px 0;color:var(--muted);font-size:.8rem;line-height:1.6}.order-customer{padding:10px;background:var(--cream);border-radius:9px;font-size:.8rem;margin:10px 0}.status-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.status-row select{max-width:250px;margin:0}.dashboard{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:18px}.stat{background:#fff;border:1px solid var(--line);border-radius:12px;padding:13px}.stat small{color:var(--muted);font-size:.68rem}.stat strong{display:block;font-family:'Fraunces';font-size:1.35rem;margin-top:4px}#loginScreen{max-width:360px;margin:90px auto;padding:0 20px;text-align:center}.login-logo{width:76px;height:76px;object-fit:cover;border-radius:50%;margin:0 auto 14px}.login-title{font-size:2rem;margin:0}.danger-note{background:#fff3f1;border:1px solid #f0c9c5;color:#7d251e;padding:10px;border-radius:9px;font-size:.74rem;margin:10px 0}@media(max-width:720px){.grid2,.grid3,.dashboard{grid-template-columns:1fr}.product-row{flex-direction:column}.product-row img{width:90px;height:110px}.order-top{flex-direction:column}}
